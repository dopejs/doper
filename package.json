{
  "name": "doper-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm wasm:build && pnpm packages:build",
    "check": "pnpm m1:check",
    "coop:check": "node scripts/audit-coop-coep.mjs",
    "contracts:check": "node scripts/validate-contracts.mjs && pnpm protocol:check && pnpm api:check",
    "api:check": "node scripts/check-public-api.mjs",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "ime:replay": "node scripts/replay-ime.mjs",
    "lint": "eslint .",
    "lockfile:check": "pnpm install --frozen-lockfile --ignore-scripts --lockfile-only",
    "m0:check": "node scripts/run-with-rust-target-cleanup.mjs pnpm m0:check:run",
    "m0:check:run": "pnpm lockfile:check && pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:check && pnpm rust:check",
    "m1:check": "node scripts/run-with-rust-target-cleanup.mjs pnpm m1:check:run",
    "m1:check:run": "pnpm m0:check && pnpm coverage:ts && pnpm coverage:rust && pnpm test:browser && pnpm m1:perf",
    "m1:perf": "node scripts/run-with-rust-target-cleanup.mjs pnpm m1:perf:run",
    "m1:perf:run": "node scripts/check-m1-performance.mjs",
    "m2:check": "node scripts/run-with-rust-target-cleanup.mjs pnpm m2:check:run",
    "m2:check:run": "pnpm m1:check",
    "m3:perf": "node scripts/run-with-rust-target-cleanup.mjs pnpm m3:perf:run",
    "m3:perf:run": "node scripts/check-m3-scroll-performance.mjs",
    "m3:diff": "node scripts/run-with-rust-target-cleanup.mjs pnpm m3:diff:run",
    "m3:diff:run": "pnpm core:wasm && node scripts/check-m3-wasm-native.mjs",
    "m3:text:foundation": "node scripts/run-with-rust-target-cleanup.mjs pnpm m3:text:foundation:run",
    "m3:text:foundation:run": "node scripts/check-m3-text-foundation.mjs",
    "m3:text:check": "node scripts/run-with-rust-target-cleanup.mjs pnpm m3:text:check:run",
    "m3:text:check:run": "pnpm m2:check && pnpm m3:text:foundation",
    "m3:check": "node scripts/run-with-rust-target-cleanup.mjs pnpm m3:check:run",
    "m3:check:run": "pnpm m3:scroll:check && pnpm m3:text:foundation",
    "m3:scroll:check": "node scripts/run-with-rust-target-cleanup.mjs pnpm m3:scroll:check:run",
    "m3:scroll:check:run": "pnpm m2:check && pnpm m3:perf && pnpm m3:diff",
    "migration:check": "node scripts/check-migration.mjs",
    "release:check": "node scripts/check-release-package.mjs",
    "playground:dev": "pnpm --filter @dopejs/playground dev",
    "playground:build": "pnpm --filter @dopejs/playground exec vite build --mode pages",
    "storybook:dev": "pnpm --filter @dopejs/storybook dev",
    "storybook:build": "pnpm --filter @dopejs/storybook build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "pages:build": "pnpm packages:build && node scripts/build-pages.mjs",
    "npm:release:verify": "node scripts/check-npm-release.mjs",
    "npm:release:publish": "pnpm npm:release:verify && pnpm -r publish --access public",
    "m5:backend:diff": "node scripts/check-m5-backend-differential.mjs",
    "m5:check": "node scripts/run-with-rust-target-cleanup.mjs pnpm m5:check:run",
    "m5:check:run": "pnpm m4:check && pnpm migration:check && pnpm release:check && pnpm m5:backend:diff",
    "m4:perf": "node scripts/run-with-rust-target-cleanup.mjs pnpm m4:perf:run",
    "m4:perf:run": "node scripts/check-m4-editing-performance.mjs",
    "m4:check": "node scripts/run-with-rust-target-cleanup.mjs pnpm m4:check:run",
    "m4:check:run": "pnpm m3:check && pnpm m4:perf",
    "m0:evidence": "pnpm platform:qualify",
    "packages:build": "pnpm core:wasm && pnpm -r --workspace-concurrency=1 build && pnpm core:wasm:check",
    "platform:qualify": "node scripts/audit-m0-evidence.mjs",
    "protocol:check": "node scripts/run-with-rust-target-cleanup.mjs pnpm protocol:check:run",
    "protocol:check:run": "node scripts/generate-protocol.mjs --check && node scripts/check-abi-roundtrip.mjs",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "probe:dev": "pnpm wasm:build && pnpm --filter @dopejs/platform-probe dev",
    "probe:dev:no-isolation": "pnpm wasm:build && pnpm --filter @dopejs/platform-probe dev:no-isolation",
    "probe:collect": "node scripts/collect-probes.mjs",
    "probe:preview": "pnpm --filter @dopejs/platform-probe preview",
    "probe:summary": "node scripts/summarize-probes.mjs",
    "rust:check": "node scripts/run-with-rust-target-cleanup.mjs pnpm rust:check:run",
    "rust:check:run": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "rust:test": "node scripts/run-with-rust-target-cleanup.mjs cargo test --workspace",
    "test": "node scripts/run-with-rust-target-cleanup.mjs pnpm test:run",
    "test:run": "pnpm packages:build && vitest run",
    "test:browser": "node scripts/run-with-rust-target-cleanup.mjs pnpm test:browser:run",
    "test:browser:run": "pnpm packages:build && vitest run --config vitest.browser.config.ts",
    "coverage:ts": "node scripts/run-with-rust-target-cleanup.mjs pnpm coverage:ts:run",
    "coverage:ts:run": "pnpm packages:build && vitest run --coverage",
    "coverage:rust": "node scripts/run-with-rust-target-cleanup.mjs pnpm coverage:rust:run",
    "coverage:rust:run": "cargo llvm-cov --workspace --no-report && cargo llvm-cov report --summary-only --fail-under-lines 85 && cargo llvm-cov report --package doper-abi --summary-only --fail-under-lines 95 && cargo llvm-cov report --package doper-scene --summary-only --fail-under-lines 95 && cargo llvm-cov report --package doper-scroll --summary-only --fail-under-lines 95 && cargo llvm-cov report --package doper-text --summary-only --fail-under-lines 94",
    "typecheck": "pnpm packages:build && pnpm -r typecheck",
    "core:wasm": "node scripts/run-with-rust-target-cleanup.mjs pnpm core:wasm:run",
    "core:wasm:run": "node scripts/build-core-wasm.mjs",
    "core:wasm:check": "node scripts/check-core-wasm.mjs",
    "wasm:build": "node scripts/run-with-rust-target-cleanup.mjs pnpm wasm:build:run",
    "wasm:build:run": "node scripts/build-wasm.mjs && node scripts/measure-wasm-budget.mjs",
    "wasm:budget": "node scripts/run-with-rust-target-cleanup.mjs pnpm wasm:budget:run",
    "wasm:budget:run": "node scripts/measure-wasm-budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.1",
    "globals": "16.4.0",
    "parse5": "8.0.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitepress": "1.6.4",
    "vitest": "4.1.10"
  }
}
