{
  "name": "doper-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm wasm:build && pnpm packages:build",
    "check": "pnpm m1:check",
    "coop:check": "node scripts/audit-coop-coep.mjs",
    "contracts:check": "node scripts/validate-contracts.mjs && pnpm protocol:check && pnpm api:check",
    "api:check": "node scripts/check-public-api.mjs",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "ime:replay": "node scripts/replay-ime.mjs",
    "lint": "eslint .",
    "m0:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:check && pnpm build && pnpm rust:check",
    "m1:check": "pnpm m0:check && pnpm coverage:ts && pnpm coverage:rust && pnpm test:browser && pnpm m1:perf",
    "m1:perf": "node scripts/check-m1-performance.mjs",
    "m0:evidence": "pnpm platform:qualify",
    "packages:build": "pnpm core:wasm && pnpm -r --workspace-concurrency=1 build && pnpm core:wasm:check",
    "platform:qualify": "node scripts/audit-m0-evidence.mjs",
    "protocol:check": "node scripts/generate-protocol.mjs --check && node scripts/check-abi-roundtrip.mjs",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "probe:dev": "pnpm wasm:build && pnpm --filter @dopejs/platform-probe dev",
    "probe:dev:no-isolation": "pnpm wasm:build && pnpm --filter @dopejs/platform-probe dev:no-isolation",
    "probe:collect": "node scripts/collect-probes.mjs",
    "probe:preview": "pnpm --filter @dopejs/platform-probe preview",
    "probe:summary": "node scripts/summarize-probes.mjs",
    "rust:check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "test": "pnpm packages:build && vitest run",
    "test:browser": "pnpm packages:build && vitest run --config vitest.browser.config.ts",
    "coverage:ts": "pnpm packages:build && vitest run --coverage",
    "coverage:rust": "cargo llvm-cov --workspace --no-report && cargo llvm-cov report --summary-only --fail-under-lines 85 && cargo llvm-cov report --package doper-abi --summary-only --fail-under-lines 95 && cargo llvm-cov report --package doper-scene --summary-only --fail-under-lines 95",
    "typecheck": "pnpm packages:build && pnpm -r typecheck",
    "core:wasm": "node scripts/build-core-wasm.mjs",
    "core:wasm:check": "node scripts/check-core-wasm.mjs",
    "wasm:build": "node scripts/build-wasm.mjs && node scripts/measure-wasm-budget.mjs",
    "wasm:budget": "node scripts/measure-wasm-budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.1",
    "globals": "16.4.0",
    "parse5": "8.0.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
