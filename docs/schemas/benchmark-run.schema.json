{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dopejs.dev/schemas/benchmark-run-v1.json",
  "title": "pingo benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteVersion",
    "runId",
    "startedAt",
    "build",
    "environment",
    "protocol",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suiteVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "buildId", "mode"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "buildId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["release", "production"] }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "deviceClass", "os", "browser", "viewport", "isolated"],
      "properties": {
        "deviceId": { "type": "string", "minLength": 1 },
        "deviceClass": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "userAgent": { "type": "string" },
        "viewport": { "type": "string", "pattern": "^[0-9]+x[0-9]+@[0-9.]+$" },
        "isolated": { "type": "boolean" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmupRuns", "measuredRuns", "sampleDurationMs", "outlierPolicy"],
      "properties": {
        "warmupRuns": { "type": "integer", "minimum": 0 },
        "measuredRuns": { "type": "integer", "minimum": 1 },
        "sampleDurationMs": { "type": "integer", "minimum": 1 },
        "outlierPolicy": { "const": "retain-all" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "runs", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["index", "rawSamples"],
              "properties": {
                "index": { "type": "integer", "minimum": 0 },
                "rawSamples": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "array",
                    "items": { "type": "number" }
                  }
                }
              }
            }
          },
          "summary": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/$defs/summary" }
          }
        }
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "min", "max", "mean", "p50", "p95", "p99"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "mean": { "type": "number" },
        "p50": { "type": "number" },
        "p95": { "type": "number" },
        "p99": { "type": "number" }
      }
    }
  }
}
