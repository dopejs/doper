{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dopejs.dev/schemas/m0-business-audit-v1.json",
  "title": "doper M0 business COOP/COEP audit evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "authenticatedSessionVerified",
    "automatedAudits",
    "dynamicResourcesVerified",
    "owner",
    "reviewedAt",
    "sessionEvidence",
    "targetOrigin",
    "transportDecision"
  ],
  "properties": {
    "$schema": { "const": "https://dopejs.dev/schemas/m0-business-audit-v1.json" },
    "version": { "const": 1 },
    "authenticatedSessionVerified": { "const": true },
    "automatedAudits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactSha256", "capturedAt", "status", "url"],
        "properties": {
          "artifactSha256": { "$ref": "#/$defs/sha256" },
          "capturedAt": { "type": "string", "format": "date-time" },
          "status": { "enum": ["blocked", "manual-review", "ready"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "dynamicResourcesVerified": { "const": true },
    "findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "owner": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "sessionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactSha256", "capturedAt", "method"],
      "properties": {
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "targetOrigin": { "type": "string", "format": "uri", "pattern": "^https://" },
    "transportDecision": { "enum": ["main-thread", "post-message", "sab"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
