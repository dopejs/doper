{
  "name": "@dopejs/pingo-host",
  "version": "0.2.1",
  "description": "pingo internal: canvas host, worker transports, and product WASM core (use @dopejs/pingo)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopejs/pingo.git",
    "directory": "packages/host"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "NOTICE",
    "dist",
    "wasm"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@dopejs/pingo-runtime": "workspace:*"
  },
  "dependencies": {
    "@dopejs/pingo-backend-canvas2d": "workspace:*",
    "@dopejs/pingo-a11y": "workspace:*",
    "@dopejs/pingo-editing": "workspace:*",
    "@dopejs/pingo-reconciler": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
