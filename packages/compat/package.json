{
  "name": "@dopejs/doper-compat",
  "version": "0.1.0",
  "description": "doper migration boundary: page-granular mount with legacy fallback",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopejs/doper.git",
    "directory": "packages/compat"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dopejs/doper": "workspace:*"
  }
}
