{
  "name": "@dopejs/pingo",
  "version": "0.2.1",
  "description": "pingo canvas rendering engine: public facade with TSX, hooks, native scrolling, and canvas-native editing",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopejs/pingo.git",
    "directory": "packages/facade"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "NOTICE",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./backend-canvas2d": {
      "types": "./dist/backend-canvas2d.d.ts",
      "import": "./dist/backend-canvas2d.js"
    }
  },
  "dependencies": {
    "@dopejs/pingo-a11y": "workspace:*",
    "@dopejs/pingo-backend-canvas2d": "workspace:*",
    "@dopejs/pingo-editing": "workspace:*",
    "@dopejs/pingo-host": "workspace:*",
    "@dopejs/pingo-jsx": "workspace:*",
    "@dopejs/pingo-reconciler": "workspace:*",
    "@dopejs/pingo-runtime": "workspace:*",
    "@dopejs/pingo-style": "workspace:*",
    "@dopejs/pingo-widgets": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
