{
  "name": "@dopejs/doper",
  "version": "0.1.0",
  "description": "doper canvas rendering engine: public facade with TSX, hooks, native scrolling, and canvas-native editing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopejs/doper.git",
    "directory": "packages/facade"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./backend-canvas2d": {
      "types": "./dist/backend-canvas2d.d.ts",
      "import": "./dist/backend-canvas2d.js"
    }
  },
  "dependencies": {
    "@dopejs/doper-a11y": "workspace:*",
    "@dopejs/doper-backend-canvas2d": "workspace:*",
    "@dopejs/doper-editing": "workspace:*",
    "@dopejs/doper-host": "workspace:*",
    "@dopejs/doper-jsx": "workspace:*",
    "@dopejs/doper-reconciler": "workspace:*",
    "@dopejs/doper-runtime": "workspace:*",
    "@dopejs/doper-widgets": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
