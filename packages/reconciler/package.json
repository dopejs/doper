{
  "name": "@dopejs/pingo-reconciler",
  "version": "0.1.0",
  "description": "pingo internal: component tree reconciler and mutation stream encoder (use @dopejs/pingo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dopejs/pingo.git",
    "directory": "packages/reconciler"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@dopejs/pingo-editing": "workspace:*",
    "@dopejs/pingo-jsx": "workspace:*",
    "@dopejs/pingo-runtime": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
